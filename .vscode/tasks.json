{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with CMake",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": "CMake configure"
        },
        {
            "label": "CMake configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "problemMatcher": []
        }
    ]
}
